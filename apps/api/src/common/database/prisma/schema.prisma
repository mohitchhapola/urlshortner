generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model urls {
  urlid        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userid       String    @db.Uuid
  original_url String
  short_code   String    @unique @db.VarChar(20)
  custom_alias String?   @unique @db.VarChar(100)
  isactive     Boolean   @default(true)
  expires_at   DateTime? @db.Timestamptz(6)
  click_count  BigInt    @default(0)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [userid], references: [uid], onDelete: Cascade)

  @@index([expires_at])
  @@index([userid])
}

model users {
  uid         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String?   @unique @db.VarChar(255)
  password    String?
  user_type   UserType  @default(GUEST)
  guest_token String?   @unique @db.Uuid
  expires_at  DateTime? @db.Timestamptz(6)
  isactive    Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  urls        urls[]

  @@index([expires_at])
  @@index([guest_token])
}

enum UserType {
  GUEST
  REGISTERED
}
